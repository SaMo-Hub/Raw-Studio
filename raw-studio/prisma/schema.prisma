generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèle pour les clés d'accès/service keys
model AccessKey {
  id          String   @id @default(cuid())
  value       String   @unique
  password    String?
  name        String?
  description String?
  role        String   @default("ADMIN")
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// Modèle pour les projets
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  shortDesc   String
  longDesc    String
  images      String
  videos      String?
  category String
  client      String?
  projectDate DateTime?
  externalLink String?
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([featured])
  @@index([isActive])
  @@index([displayOrder])
}

// Modèle pour les éléments de la homepage de raw-sport
model RawSportHomeItem {
  id          String   @id @default(cuid())
  imageName   String
  imageUrl    String
  type        String
  client      String?
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

// Modèle pour les éléments de la galerie de raw-sport
model RawSportGalleryItem {
  id          String   @id @default(cuid())
  imageName   String
  imageUrl    String
  category    String
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([displayOrder])
}
