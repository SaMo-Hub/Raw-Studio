generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modèle pour les utilisateurs/clés d'accès
model AccessKey {
  id          String   @id @default(cuid())
  value       String   @unique // Hash bcrypt du mot de passe
  password    String?  // Mot de passe en clair (optionnel, pour affichage)
  name        String?  // Nom de la clé (ex: "Service User 1")
  description String?  // Description optionnelle
  role        String   @default("ADMIN") // ADMIN ou SERVICE
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
}

// Modèle pour les projets
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  
  // Description
  shortDesc   String   // 1-2 lignes
  longDesc    String   // Déscription complète (markdown possible)
  
  // Contenu visuel
  images      String   // JSON array de URLs
  videos      String?  // JSON array de URLs vidéo (optionnel)
  
  // Stack technique
  technologies String  // JSON array
  
  // Infos du projet
  client      String?  // Nom du client
  projectDate DateTime? // Date du projet
  
  // Métadonnées
  externalLink String? // Lien vers le site/démo
  featured    Boolean  @default(false) // Projet en vedette
  isActive    Boolean  @default(true) // Projet visible ou non
  displayOrder Int     @default(0) // Ordre d'affichage
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([featured])
  @@index([isActive])
  @@index([displayOrder])
}

// Modèle pour les éléments de la homepage de raw-sport (3 carousels)
model RawSportHomeItem {
  id          String   @id @default(cuid())
  imageName   String   // Nom de l'image
  imageUrl    String   // URL de l'image
  type        String   // "athletes", "press", ou "clubs"
  client      String?  // Nom du client
  isActive    Boolean  @default(true) // Statut (en ligne ou pas)
  displayOrder Int     @default(0) // Ordre d'affichage
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

// Modèle pour les éléments de la galerie de raw-sport
model RawSportGalleryItem {
  id          String   @id @default(cuid())
  imageName   String   // Nom de l'image
  imageUrl    String   // URL de l'image
  category    String   // "photo", "graphic-design", "film"
  isActive    Boolean  @default(true) // Statut (en ligne ou pas)
  displayOrder Int     @default(0) // Ordre d'affichage
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([isActive])
  @@index([displayOrder])
}
